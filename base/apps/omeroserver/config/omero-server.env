CONFIG_omero_client_icetransports=ssl,tcp
CONFIG_omero_glacier2_icetransports=ssl,tcp
CONFIG_omero_db_host=database
CONFIG_omero_fs_repo_path=%group%/%userId%/%year%_%month%/%day%/%time%
OMERO_DBHOST=database
CONFIG_omero_db_poolsize=100
CONFIG_omero_server_nodedescriptors=master:Blitz-0 omeroworker-0:Processor-0,Tables-0 omeroworker-1:Indexer-0,PixelData-0 omeroworker-2:DropBox,MonitorServer,FileServer,Storm
